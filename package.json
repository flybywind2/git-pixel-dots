{
  "name": "git-pixel-dots",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "qa:visual": "node scripts/verify-render.mjs",
    "qa:all": "npm run typecheck && npm test && npm run build && npm run qa:visual"
  },
  "dependencies": {
    "lucide-react": "^1.0.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.52.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
